# Streamlit Cloud: uygulama → Settings → Secrets bölümüne yapıştırın.
# Yerelde ".streamlit/secrets.toml" olarak kaydedin (bu dosya GitHub'a gitmez).

# --- Açılış şifresi (ZORUNLU: tanımlı değilse uygulama kilitli kalır) ---
APP_PASSWORD = "buraya-sifre"

# --- OpenSky (önerilir; hesapsız günlük kota düşüktür) ---
opensky_client_id = ""
opensky_client_secret = ""

# --- Terminal ekranı (Varış / Kalkış): AeroDataBox, RapidAPI ücretsiz plan ---
AERODATABOX_KEY = ""
# AERODATABOX_HOST = "aerodatabox.p.rapidapi.com"
# ADB_MONTHLY_UNITS = 600            # planınızdaki aylık birim (ücretsiz: 600)

# --- Veritabanı yedeği: GitHub `data` dalı ---
# Fine-grained token: yalnızca bu depo, İzin: Contents -> Read and write
GITHUB_TOKEN = ""
GITHUB_REPO = "Blixembosch/atlasradar"
# DATA_BRANCH = "data"
# DB_PUSH_MIN = 20                   # değişiklik varsa en çok kaç dakikada bir yedeklensin

# --- İsteğe bağlı: depo herkese açıksa ev konumunu kodda değil buradan verin ---
# HOME_LAT = "51.4951"
# HOME_LON = "5.4779"
